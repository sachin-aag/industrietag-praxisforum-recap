# Copy to .env.local for local dev; set the same values in Vercel → Project → Settings → Environment Variables.

# Random 32-byte secrets (generate each with: openssl rand -base64 32)
AUTH_SECRET=
# Must be the SAME key that encrypted src/server/knowledge.enc.json (see scripts/build-knowledge.mjs)
KNOWLEDGE_KEY=

# Registered attendees, comma-separated. Only these addresses receive a login link.
ALLOWED_EMAILS=

# Resend (existing account). Sender must be on a domain verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Praxisforum 2026 <praxisforum@your-verified-domain.de>"

# OpenRouter
OPENROUTER_API_KEY=
# Optional, defaults to google/gemma-4-31b-it:free
OPENROUTER_MODEL=

# Public URL used in magic links, e.g. https://praxisforum-recap.vercel.app
SITE_URL=

# Lifetime usage limits per attendee (stored in Upstash Redis; add it via Vercel → Storage → Upstash,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN automatically). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_MAX_QUERIES=100
CHAT_MAX_TOKENS=2500000
